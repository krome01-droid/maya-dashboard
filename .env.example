# ── NextAuth ────────────────────────────────────────────────
NEXTAUTH_SECRET=            # openssl rand -base64 32
NEXTAUTH_URL=https://agent.moto-ecole-inris.fr/admin-maya

# ── Compte de service local ─────────────────────────────────
# Permet d'entrer même si Supabase Auth est indisponible.
ADMIN_USERNAME=maya
ADMIN_PASSWORD=

# ── Base de la marketplace (projet ngjdoxiiipctmjewvrfu) ─────
# service_role : lecture serveur uniquement, jamais exposée au navigateur.
SUPABASE_URL=https://ngjdoxiiipctmjewvrfu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# anon : sert à valider le mot de passe d'un admin via Supabase Auth.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── CROME OS ────────────────────────────────────────────────
# Le hub décide de ce qui part. Ce secret permet de PROPOSER, pas de publier.
CROME_INGEST_URL=https://<projet>.supabase.co/functions/v1/submit-post
CROME_INGEST_SECRET=

# ── IA ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Tâches planifiées ───────────────────────────────────────
# Sans lui, les routes /api/cron refusent tout : pas de repli permissif.
CRON_SECRET=

# ── Brief quotidien (Resend) ────────────────────────────────
RESEND_API_KEY=
BRIEF_TO=
BRIEF_FROM=MAYA <maya@moto-ecole-inris.fr>
